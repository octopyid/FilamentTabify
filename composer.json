{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "octopyid/filament-tabify",
    "description": "Transform your Filament dashboard with elegant Tabbed Widgets",
    "keywords": [
        "laravel", "filament", "filament-plugin", "widgets", "tabs", "dashboard"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Supian M",
            "email": "supianidz@octopy.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4|^5",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Octopy\\Filament\\Tabify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Octopy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Octopy\\Filament\\Tabify\\Providers\\TabifyServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "pint --test",
        "format": "pint",
        "test": "pest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
